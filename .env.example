# Neon Postgres connection (pooled URL for web traffic)
DATABASE_URI=
# Required, random secret; never commit real credentials
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=https://ek-collection.vercel.app
# Temporary: first-time schema setup on an EMPTY database only; disable afterwards
PAYLOAD_DB_PUSH=false
# Optional Neon Object Storage S3 integration (bucket must be public-read for product images)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET=uploads
# Contact info is displayed only if set
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
